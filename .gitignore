node_modules/
dist/
*.tsbuildinfo
.DS_Store
*.log
/release/

# Runtime state inside an opened workspace (never committed)
.digital-employee/staging/
.digital-employee/rejected/
.digital-employee/applied/
.digital-employee/archive/

# Local state generated when the desktop app auto-opens the example workspace
examples/*/.digital-employee/

# Nested CXO scene copies must not contribute local runtime state.
examples/cxo-company/scenarios/*/.digital-employee/
examples/cxo-company/scenarios/*/.roleweave/

# Workspaces generated by scripts/sync-qoder-org.mjs (regenerable; carries runtime state)
workspaces/

# Generated by scripts/bundle-updater.mjs from the pinned electron-updater.
apps/desktop/src/vendor/
