{
  "name": "@roleweave/shared",
  "version": "0.0.0",
  "description": "Contract types for RoleWeave. Mirrors digital-employee contracts; the client never invents semantics.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./position-id": {
      "types": "./dist/position-id.d.ts",
      "import": "./dist/position-id.js",
      "require": "./position-id.cjs"
    },
    "./turn-engines": {
      "require": "./turn-engines.cjs"
    },
    "./pending-approval": {
      "types": "./dist/pending-approval.d.ts",
      "import": "./dist/pending-approval.js",
      "require": "./pending-approval.cjs"
    },
    "./approval-redaction": {
      "types": "./dist/approval-redaction.d.ts",
      "import": "./dist/approval-redaction.js"
    },
    "./docs": {
      "types": "./dist/docs.d.ts",
      "import": "./dist/docs.js"
    },
    "./model-selection": {
      "types": "./dist/model-selection.d.ts",
      "import": "./dist/model-selection.js"
    },
    "./capabilities": {
      "types": "./dist/capabilities.d.ts",
      "import": "./dist/capabilities.js"
    },
    "./goals": {
      "types": "./dist/goals.d.ts",
      "import": "./dist/goals.js"
    },
    "./attachments": {
      "types": "./dist/attachments.d.ts",
      "import": "./dist/attachments.js"
    }
  },
  "files": [
    "dist",
    "position-id.cjs",
    "turn-engines.cjs",
    "pending-approval.cjs"
  ]
}
